    "d3": "^7.9.0",
    "dayjs": "^1.11.20",
    "highlight.js": "^11.11.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
