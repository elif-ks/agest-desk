{
  "name": "agest-desk",
  "version": "1.0.0",
  "private": true,
  "description": "AGEST Desk - Şirket içi talep ve departman yönetim sistemi",
  "scripts": {
    "dev": "cross-env UMI_ENV=dev MOCK=none max dev",
    "start": "cross-env UMI_ENV=dev MOCK=none max dev",
    "build": "max build",
    "preview": "max preview --port 8000",
    "preview:build": "max build && max preview --port 8000",
    "lint": "npm run biome:lint && npm run tsc",
    "biome:lint": "biome lint",
    "biome": "biome check --write",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@rc-component/util": "^1.12.0",
